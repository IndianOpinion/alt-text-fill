{
    "name": "indianopinion/alt-text-fill",
    "description": "WordPress plugin that suggests alt text for images that have none, through a vision model you choose, with human review, undo, dry run, caps and a kill switch.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": ["wordpress", "alt text", "accessibility", "media library", "vision"],
    "homepage": "https://github.com/IndianOpinion/alt-text-fill",
    "support": {
        "issues": "https://github.com/IndianOpinion/alt-text-fill/issues",
        "email": "hello@indianopinion.org"
    },
    "authors": [
        {"name": "Indian Opinion", "email": "hello@indianopinion.org"}
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.10",
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10"
    },
    "suggest": {
        "ext-gd": "Scales large images in memory before sending (or ext-imagick).",
        "ext-imagick": "Scales large images in memory before sending (or ext-gd)."
    },
    "autoload": {
        "psr-4": {"IndianOpinion\\AltTextFill\\": "src/"},
        "files": ["src/functions.php"]
    },
    "autoload-dev": {
        "psr-4": {"IndianOpinion\\AltTextFill\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "phpunit --testsuite integration",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "phpcs",
        "cbf": "phpcbf",
        "check": ["@cs", "@stan", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
